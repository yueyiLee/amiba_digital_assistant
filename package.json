{
  "name": "amoeba-operating-assistant",
  "version": "1.1.0",
  "description": "阿米巴经营数字助手 - 面向微小企业的阿米巴经营数据记录与分析 Web 应用（PostgreSQL 版）",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const p=require('path');const src=p.join(__dirname,'public');const dst=p.join(__dirname,'dist','public');if(!fs.existsSync(dst)){fs.cpSync(src,dst,{recursive:true})}\"",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "openai": "^6.48.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@cloudbase/framework-plugin-container": "^1.9.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
